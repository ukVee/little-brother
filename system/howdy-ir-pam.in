#!/usr/bin/env bash
# pam_exec helper: bring the IR feeder up just before pam_howdy.so runs.
#
# GENERATED -- do not edit this copy. It is rendered from
# <repo>/system/howdy-ir-pam.in by `cement-ir pam install-helper`, which
# substitutes the repo path below. This is the one file in the system that has to
# name the repo by absolute path (it lives outside the tree, so it cannot resolve
# it from its own location); everything else derives paths from the entry point.
# If you move the repo, re-run that command -- `cement-ir doctor` checks it.
#
# pam_howdy knows nothing about our feeder, and the ov7251 emits ip3y that
# OpenCV cannot decode -- so irface.py must be unpacking frames onto
# /dev/video20 (and driving the illuminator) before Howdy opens the device.
#
# ALWAYS exits 0. It is wired as `auth optional`, so it must never be able to
# block authentication; if anything here fails, Howdy simply finds no camera
# and PAM falls through to the password.
#
# Skips SSH sessions entirely. Howdy's own abort_if_ssh already refuses to
# authenticate a remote user by camera, so starting the feeder there would fire
# the IR emitter and add seconds of latency to every remote sudo for nothing.
# Logging must never be fatal. pam_exec runs this with the REAL uid unless the
# module is given `seteuid`, so without it this script is uid 1000 and cannot
# write to /var/log -- which silently killed it at line 1 and left no trace of
# why the camera never came up.
CEMENT_IR_ROOT=@CEMENT_IR_ROOT@

LOG=/var/log/howdy-ir-pam.log
if ! { : >>"$LOG"; } 2>/dev/null; then
  LOG=/tmp/howdy-ir-pam.log
  { : >>"$LOG"; } 2>/dev/null || LOG=/dev/null
fi
exec >>"$LOG" 2>&1
echo "--- $(date -Is) service=${PAM_SERVICE:-?} user=${PAM_USER:-?} tty=${PAM_TTY:-?}"
echo "  uid=$(id -u) euid=$(id -un) log=$LOG"
if [[ $(id -u) -ne 0 ]]; then
  echo "  NOT ROOT -- the pam_exec line needs the 'seteuid' option; giving up"
  exit 0
fi

# Walk the process ancestry looking for sshd. PAM_RHOST is empty for sudo
# inside an ssh session, so it cannot be used to detect this.
p=$PPID
for _ in $(seq 1 12); do
  [[ -r /proc/$p/comm ]] || break
  c=$(</proc/$p/comm)
  if [[ $c == sshd* ]]; then
    echo "  ssh session detected -- skipping (howdy aborts on ssh anyway)"
    exit 0
  fi
  p=$(awk '{print $4}' "/proc/$p/stat" 2>/dev/null) || break
  [[ ${p:-0} -gt 1 ]] || break
done

# Already fed? Another auth attempt may still have a feeder running.
if pgrep -f "irface.py .* feed " >/dev/null 2>&1; then
  echo "  feeder already running"
  exit 0
fi

# A repo that has moved is the failure this line exists to make loud: before
# this check, a relocated checkout left the two paths below dangling and face
# auth just stopped trying the camera -- silently, because this script is
# `auth optional` and always exits 0.
if [[ ! -x $CEMENT_IR_ROOT/lib/irface.py ]]; then
  echo "  STALE HELPER: no repo at $CEMENT_IR_ROOT"
  echo "  fix: sudo <repo>/cement-ir pam install-helper"
  exit 0
fi

# The sensor wedges after most feeder runs (STREAMON EINVAL, I2C EREMOTEIO);
# rebinding ov7251 clears it. No-op when healthy.
timeout 25 "$CEMENT_IR_ROOT/lib/sensor-recover.sh" >/dev/null 2>&1
echo "  sensor check rc=$?"

# Cheap pre-flight in front of the feeder: the module/link/loopback subset of
# cement-ir doctor. One verdict line in the log, never blocking -- this script
# is `auth optional` and exits 0 whatever doctor reports. The expensive checks
# stay manual (`cement-ir doctor`).
if bash "$CEMENT_IR_ROOT/lib/doctor.sh" --quick; then
  echo "  doctor quick rc=0"
else
  echo "  doctor quick rc=$?"
fi

# The feeder signals its own readiness: after the first unpacked frame reaches
# ffmpeg it touches $READY. This replaces the python-opencv probe the
# 2026-09-06 orphan sweep silently killed -- 24 auth attempts ran with the
# gate dead and logged a warning into /dev/null. No interpreter import, no
# OpenCV, nothing left to orphan. The marker is per-invocation ($$), so two
# attempts cannot cross-talk, and the feeder deletes it on exit.
READY=/run/cement-ir/feed-ready.$$
mkdir -p /run/cement-ir && chmod 700 /run/cement-ir

setsid "$CEMENT_IR_ROOT/lib/irface.py" --gain 128 --current 1 \
    feed --device /dev/video20 --duration 15 --fps 10 --ready-file "$READY" \
    >/dev/null 2>&1 &
FEEDER=$!
echo "  feeder started pid $FEEDER"

# Wait for the feeder's own signal -- bounded, and logged with the reason it
# gave up. The old probe read the loopback the way Howdy does; the feeder
# knows first-hand when a frame reached ffmpeg, which is the moment a reader
# can start pulling. pam_howdy opens the device once and OpenCV gives up on
# the first failed read, which is the race this gate exists to stop.
for _ in $(seq 1 12); do
  if [[ -f $READY ]]; then
    echo "  feeder signaled readiness"
    exit 0
  fi
  kill -0 "$FEEDER" 2>/dev/null || break
  sleep 0.4
done
if kill -0 "$FEEDER" 2>/dev/null; then
  echo "  WARNING: feeder never signaled readiness in ~5s; howdy will fall through"
else
  echo "  WARNING: feeder died before signaling readiness; howdy will fall through"
fi
exit 0
